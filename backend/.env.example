# Copy this file to .env and fill in your values. Never commit .env to git.

# OpenAI API key — used for embeddings and chat completion
OPENAI_API_KEY=

# OpenAI chat model to use
OPENAI_CHAT_MODEL=gpt-4o-mini

# Pinecone API key
PINECONE_API_KEY=

# Name of your Pinecone index
PINECONE_INDEX_NAME=

# Pinecone namespace (leave empty for default)
PINECONE_NAMESPACE=

# Cohere API key — used for reranking
COHERE_API_KEY=

# Enable Cohere reranking for better retrieval accuracy
COHERE_RERANK_ENABLED=true

# Application environment: development or production
APP_ENV=development

# Maximum upload file size in megabytes
MAX_FILE_SIZE_MB=25
